# Copy to .env (gitignored) and fill in. Read by deploy.sh.
DEPLOY_HOST=user@your-server.example   # ssh target; needs passwordless sudo
DEPLOY_DIR=/srv/diku3d                 # where nginx serves the files from
DEPLOY_SITE=diku3d-com                 # name under /etc/nginx/sites-available
DEPLOY_URL=https://diku3d.com          # checked from outside after the copy
